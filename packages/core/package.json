{
  "name": "@whoobe-cms/core",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./docs": {
      "types": "./dist/docs/index.d.ts",
      "import": "./dist/docs/index.js",
      "default": "./dist/docs/index.js"
    },
    "./docs-search": {
      "types": "./dist/docs/search.d.ts",
      "import": "./dist/docs/search.js",
      "default": "./dist/docs/search.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:backfill-gateway-auth": "tsx src/db/scripts/backfill-gateway-auth-encryption.ts",
    "db:reset-password": "tsx src/db/scripts/reset-user-password.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@google/generative-ai": "^0.24.1",
    "@whoobe-cms/schema": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "js-yaml": "^5.4.2",
    "marked": "^14.1.4",
    "minisearch": "^7.2.0",
    "nodemailer": "^10.0.16",
    "openai": "^7.32.0",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "tw-to-css": "^0.0.12",
    "xstate": "^5.33.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.32.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
