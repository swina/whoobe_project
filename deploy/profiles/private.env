# Workspace profile "private" (scripts/provision-workspace.sh <slug> <host> <index> --profile private).
# For an installation on a network with no route to the internet (or one that must not use it): a VPN, a LAN, an air-gapped site.
# Appended to the workspace's .env.<slug>, like the "sandbox" profile; change a value with `--set KEY=VALUE` or by editing .env.<slug> and recreating
# the containers (the VITE_ ones are read when the images are built). Page: docs/release/operations/private-network.md
#
# Fonts: the editor preloads the list below from Google Fonts at start; empty = none (Inter, the interface font, ships with the apps)
VITE_FONT_FAMILIES=
# Placeholder pictures of starter and generated pages: a flat grey picture carried by the code instead of a photo from picsum.photos
PLACEHOLDER_IMAGES=local
VITE_PLACEHOLDER_IMAGES=local
# Outbound HTTP (safeFetch): private addresses stay allowed, because an AI model, a mail relay or a CMS source on the same network is the normal case here.
# Set false to forbid them, and list the hosts that stay reachable in OUTBOUND_ALLOW_HOSTS (comma separated host names).
OUTBOUND_ALLOW_PRIVATE=true
