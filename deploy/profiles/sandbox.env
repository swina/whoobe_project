# Workspace profile "sandbox" (scripts/provision-workspace.sh <slug> <host> <index> --profile sandbox).
# Appended to the workspace's .env.<slug>: a sandbox is an ordinary workspace plus these values. Change one with
# `--set KEY=VALUE` at provisioning time, or edit .env.<slug> and recreate the containers. Docs: docs/release/operations/sandbox.md
#
# Containers: the overlay with the hardening (read-only root, no capabilities, resource limits). Compose reads
# COMPOSE_FILE from the env file, so every command on this workspace (up, down, remove-workspace.sh) uses it.
COMPOSE_FILE=docker-compose.yml:docker-compose.sandbox.yml
# false only where the flag breaks image entrypoints (snap-installed Docker + AppArmor); keep true on a public host
SANDBOX_NO_NEW_PRIVILEGES=true
# Product: switches the restrictions on (AI, mail, Figma/migration imports, CDN mirror and PWA generation are refused,
# users/roles are read-only) and shows the reset banner
SANDBOX_MODE=1
# Assets
ASSET_MAX_FILE_BYTES=5242880
ASSET_MAX_COUNT=50
ASSET_MAX_INPUT_PIXELS=16000000
# Outbound HTTP (safeFetch): only these host names, exact match; empty = none
SANDBOX_ALLOW_HOSTS=dummyjson.com
# Public API rate limits (per minute)
PUBLIC_RATE_LIMIT_PER_MINUTE=60
PUBLIC_SEARCH_RATE_LIMIT_PER_MINUTE=30
PUBLIC_QUERY_RATE_LIMIT_PER_MINUTE=30
# Edge (nginx): request body cap and per-address limits, rendered into the workspace's locations include
WS_MAX_BODY=6M
WS_EDGE_LIMITS=limit_req zone=sandbox_req burst=40 nodelay; limit_conn sandbox_conn 20; limit_req_status 429; limit_conn_status 429; proxy_read_timeout 60s; proxy_send_timeout 60s;
