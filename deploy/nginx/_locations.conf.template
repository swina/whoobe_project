# Shared location blocks for a workspace vhost - included (via nginx
# `include`) from both the plain-HTTP server block
# (workspace.conf.template / workspace-redirect.conf.template once TLS is
# on) and the HTTPS one (workspace-ssl.conf.template), so the routing
# rules only exist in one place regardless of whether TLS is enabled.
#
# Rendered by scripts/provision-workspace.sh into
# deploy/nginx/_locations-<slug>.inc (the leading underscore and .inc
# extension keep it out of nginx conf.d's `include *.conf` autoload - it
# must only ever be pulled in explicitly via `include`, never parsed as
# its own top-level config file).
#
# Named .inc (not .conf) is deliberate: nginx:alpine's default conf.d
# `include *.conf` would otherwise try to load this fragment directly,
# which fails immediately (bare `location {}` blocks outside a `server{}`
# context are a syntax error at that scope).

# Optional server-level limits (empty by default; the public sandbox sets WS_EDGE_LIMITS, see scripts/sandbox/reset.sh)
__EDGE_LIMITS__

# Request body cap for the WHOLE server: nginx's own default is 1 MB, which applies to every location without a
# directive of its own and answered 413 to any JSON body above 1 MB sent to core-api (a website import, a large
# page, an AI-generated page, a kit) - only the asset upload location below used to set it. The applications have
# their own limits behind this (core-api and gateway 25 MB of JSON, the asset-processor's per-file cap).
client_max_body_size __MAX_BODY__;

# Dashboard or website preview? The dashboard (Vue SPA) and the previews of the websites share this location: a path
# is a website's when its first segment is the root (preview) path of one - /whoobe-website/blog, set in Websites -,
# anything else is the dashboard. core-api decides (GET /site-root, 204 or 403, from a 5 s cache): this is how a
# website is previewed at its own root path instead of under /whoobe-one/, the way it is on a local installation.
# The names the proxy routes itself (below), /assets/ and the usual files are never offered as roots (core-api refuses
# them as root paths). If core-api cannot be asked, the request goes to the dashboard, as it always did.
location = /_whoobe_site_root {
    internal;
    proxy_pass http://127.0.0.1:__CORE_API_PORT__/site-root;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header X-Original-URI $request_uri;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @whoobe_not_a_site;
}

location @whoobe_not_a_site {
    return 403;
}

# Built files of the dashboard: no need to ask who owns the path
location /assets/ {
    proxy_pass http://127.0.0.1:__ADMIN_PORT__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location / {
    auth_request /_whoobe_site_root;
    error_page 403 = @whoobe_dashboard;
    # the editor container answers index.html for any path; the app renders the page of the website from the URL
    proxy_pass http://127.0.0.1:__WHOOBE_ONE_PORT__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Admin dashboard (Vue SPA)
location @whoobe_dashboard {
    proxy_pass http://127.0.0.1:__ADMIN_PORT__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# /whoobe-one API routes -> core-api (must be before the SPA catch-all)
location ~ ^/whoobe-one/(websites|themes|pages|snippets|templates|kits|website-paths|search|settings|site-wizard|site-spec|editor-base)(/.*)?$ {
    proxy_pass http://127.0.0.1:__CORE_API_PORT__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Whoobe One editor (embedded in admin dashboard, direct access)
# Trailing slash on proxy_pass DOES strip the /whoobe-one/ prefix here -
# deliberately the opposite of docs/release/operations/deployment.md's reference nginx
# config, which fronts `vite preview` (base-aware, expects the full
# /whoobe-one/... path). This workspace's whoobe-one-spike instead runs
# as a Docker image (Dockerfile's `whoobe-one-spike` target: a generic
# nginx:alpine serving the static dist/ via nginx/admin-spa.conf / nginx/editor-spa.conf.template,
# which has no idea what prefix it's reverse-proxied under) - its actual
# files live at the container's own root (/assets/*.js, /editor, ...),
# so the prefix must come off before forwarding or every asset request
# 404s into the SPA fallback (index.html, wrong MIME type - blank canvas,
# Vue never mounts).
location /whoobe-one/ {
    proxy_pass http://127.0.0.1:__WHOOBE_ONE_PORT__/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Bytes of a file a visitor uploads through a form (docs/plans/forms/form-upload-plan.md): to the asset service, not core-api, which
# is what the rest of /public/ is. ^~ so the regex location below does not take it. The body is passed on as it arrives.
location ^~ /public/upload-data/ {
    proxy_pass http://127.0.0.1:__ASSET_PROCESSOR_PORT__;
    proxy_request_buffering off;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Names the dashboard router and core-api share (/documents, /pages, /settings): the browser asks for the page itself (opening the
# address, a refresh, a link: Sec-Fetch-Dest document) -> the dashboard; the dashboard's own calls (fetch, no such header value)
# -> core-api. Exact paths only; every other navigation to core-api (OIDC login, previews, published sites) is untouched.
location ~ ^/(documents|pages|settings)/?$ {
    error_page 418 = @whoobe_dashboard;
    if ($http_sec_fetch_dest = document) {
        return 418;
    }
    proxy_pass http://127.0.0.1:__CORE_API_PORT__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# core-api routes
location ~ ^/(auth|documents|snippets|data-classes|data-components|data-objects|mail-settings|mail-providers|mail-log|mail-templates|migration-sources|health|search|themes|public|ai|figma|preview|sites|pages|settings|workflows|users|roles|docs-sites|object-event-subscriptions|object-event-deliveries|audit-log|security-settings|oidc-settings|data-subject|pwa|fonts)(/.*)?$ {
    proxy_pass http://127.0.0.1:__CORE_API_PORT__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Publication from the dashboard (core-api queues the jobs; only the person's routes are exposed, never /publish/runner/*, which the
# publisher service calls inside the stack with its token) and the system log viewer: core-api, before the /api/v1/ block below
location ~ ^/(publish/jobs|api/v1/system)(/.*)?$ {
    proxy_pass http://127.0.0.1:__CORE_API_PORT__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# gateway API routes (must come before the /api/v1/ block below)
location /api/v1/gateway/ {
    proxy_pass http://127.0.0.1:__GATEWAY_PORT__/api/v1/gateway/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# applications that call the gateway with an API key (apps/gateway/src/client-router.ts)
location /client/v1/ {
    proxy_pass http://127.0.0.1:__GATEWAY_PORT__/client/v1/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /api/remote/ {
    proxy_pass http://127.0.0.1:__GATEWAY_PORT__/api/remote/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# asset-processor API routes
location /api/v1/ {
    proxy_pass http://127.0.0.1:__ASSET_PROCESSOR_PORT__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# DAM public asset proxy
location /dam-asset/ {
    proxy_pass http://127.0.0.1:__ASSET_PROCESSOR_PORT__/dam-asset/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    expires 1y;
    add_header Cache-Control "public, immutable";
}
