# Per-workspace nginx vhost template (HTTP-only bootstrap - add SSL the
# same way as docs/deployment.md §9-10 once the workspace's domain is
# pointed at this host: `sudo certbot --nginx -d __HOSTNAME__`).
#
# Rendered by scripts/provision-workspace.sh into deploy/nginx/<slug>.conf
# by substituting the placeholders below with that workspace's hostname
# and its own host-side port block. Location blocks mirror
# docs/deployment.md's single-tenant config exactly - only the upstream
# ports and server_name change per workspace, so N workspaces on the same
# host are just N of these vhosts, each routing only to its own
# containers.
#
# Enable: ln -s deploy/nginx/<slug>.conf /etc/nginx/sites-enabled/<slug>
#         nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name __HOSTNAME__;

    # Admin dashboard (Vue SPA)
    location / {
        proxy_pass http://127.0.0.1:__ADMIN_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /whoobe-one API routes -> core-api (must be before the SPA catch-all)
    location ~ ^/whoobe-one/(websites|themes|pages|snippets|templates|kits|website-paths|search)(/.*)?$ {
        proxy_pass http://127.0.0.1:__CORE_API_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Whoobe One editor (embedded in admin dashboard, direct access)
    # No trailing slash on proxy_pass - do NOT strip the /whoobe-one/
    # prefix here (vite preview is built with base: '/whoobe-one/').
    location /whoobe-one/ {
        proxy_pass http://127.0.0.1:__WHOOBE_ONE_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # core-api routes
    location ~ ^/(auth|documents|snippets|data-classes|data-components|data-objects|mail-settings|mail-log|mail-templates|migration-sources|health|search|themes|public|ai|figma|preview|sites|pages|settings|workflows|users|roles)(/.*)?$ {
        proxy_pass http://127.0.0.1:__CORE_API_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # gateway API routes (must come before the /api/v1/ block below)
    location /api/v1/gateway/ {
        proxy_pass http://127.0.0.1:__GATEWAY_PORT__/api/v1/gateway/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/remote/ {
        proxy_pass http://127.0.0.1:__GATEWAY_PORT__/api/remote/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # asset-processor API routes
    location /api/v1/ {
        proxy_pass http://127.0.0.1:__ASSET_PROCESSOR_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 100M;
    }

    # DAM public asset proxy
    location /dam-asset/ {
        proxy_pass http://127.0.0.1:__ASSET_PROCESSOR_PORT__/dam-asset/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
