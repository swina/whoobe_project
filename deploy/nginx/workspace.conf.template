# Per-workspace nginx vhost - HTTP-only bootstrap state (before TLS is
# enabled). Rendered by scripts/provision-workspace.sh into
# deploy/nginx/<slug>.conf.
#
# The /.well-known/acme-challenge/ location is always present (even if
# TLS is never enabled) so a workspace never has to be re-rendered just
# to become eligible for it later - it's a no-op location until
# scripts/enable-tls.sh actually asks Let's Encrypt for a certificate.
#
# Once scripts/enable-tls.sh succeeds for this workspace, this file is
# OVERWRITTEN from workspace-redirect.conf.template (plain HTTP starts
# redirecting to HTTPS instead of proxying) and a sibling
# deploy/nginx/<slug>-ssl.conf (from workspace-ssl.conf.template) is
# added for port 443 - both include the very same
# deploy/nginx/_locations-<slug>.inc this file does, so the actual
# routing rules never have to be duplicated by hand.
#
# Enable (host nginx only - the containerized shared proxy needs no
# manual step): ln -s deploy/nginx/<slug>.conf /etc/nginx/sites-enabled/<slug>
#                nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name __HOSTNAME__;

    location /.well-known/acme-challenge/ {
        root __CERTBOT_WEBROOT__;
    }

    include __LOCATIONS_INCLUDE__;
}
