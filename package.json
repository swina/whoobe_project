{
  "name": "pimcore-to-custom",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "publish:site": "pnpm run --filter @whoobe-cms/publish... build && node packages/publish/bin/whoobe-publish.js",
    "publish:sync-cdn": "pnpm run --filter @whoobe-cms/publish... build && node packages/publish/bin/whoobe-sync-cdn.js",
    "security:static": "bash scripts/security/static/run-all.sh",
    "security:api": "pnpm --filter @whoobe-cms/security test:api",
    "security:all": "bash -c 'pnpm security:static; s=$?; pnpm security:api; a=$?; [ $s -eq 0 ] && [ $a -eq 0 ]'",
    "security:tls": "bash scripts/security/tls/run-testssl.sh",
    "security:images": "bash scripts/security/images/run-trivy-image.sh",
    "security:isolation": "bash scripts/security/isolation/run.sh",
    "security:browser": "pnpm --filter @whoobe-cms/security test:browser"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "nanoid": "^3.3.18",
      "underscore": "^1.13.8",
      "qs": "^6.16.0",
      "fast-uri": "^3.1.8",
      "markdown-it": "^14.3.3",
      "dompurify": "^3.4.17",
      "proxy-addr": "^2.0.8",
      "source-map-js": "^1.2.2",
      "prosemirror-view": "^1.42.3",
      "vue": "^3.5.42",
      "@vue/server-renderer": "^3.5.42"
    }
  }
}
