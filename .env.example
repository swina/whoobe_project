# Whoobe CMS - single source of truth for all configuration.
#
# Every app reads this one file: docker-compose.yml interpolates the
# POSTGRES_* vars; the Node services (core-api, asset-processor,
# migration-tool) load it through @whoobe-cms/core's loadRootEnv(); the
# Vite apps (admin-dashboard, whoobe-one-spike) load it via envDir in
# their vite.config.ts.
#
# ${VAR} references are expanded - Vite does this natively (dotenv-expand),
# loadRootEnv() implements the same expansion for the Node services.
# Shell-exported variables always win over the values in this file, which
# is how ./dev-cms.sh --hostname <name> overrides the hostname per run.

# The hostname all derived URLs below are built from. Change it here for
# the whole stack at once (e.g. WHOOBE_HOSTNAME=develop.local for LAN
# access), or per run via: ./dev-cms.sh --hostname develop.local
WHOOBE_HOSTNAME=localhost
DB_HOSTNAME=localhost
S3_ENDPOINT_HOSTNAME=localhost

# --- Postgres container (docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=whoobe_db

# --- Shared Postgres connection (core-api, asset-processor, migration-tool) ---
DB_HOST=${DB_HOSTNAME}
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me_postgres_password
DB_NAME=whoobe_db
# TLS to Postgres: disable (default) | require | verify-full. DB_SSL_CA = path or PEM of the CA (see docs/release/operations/encryption.md)
# DB_SSL=disable
# DB_SSL_CA=

# --- core-api only ---
# Encryption key for stored Pimcore migration sources (aes-256, 32 bytes).
MIGRATION_SOURCE_ENCRYPTION_KEY=change_me_migration_source_key

# --- gateway only ---
# Encryption key for stored API Gateway endpoint credentials (aes-256, 32
# bytes) - separate from MIGRATION_SOURCE_ENCRYPTION_KEY above so a leak of
# one secret class doesn't compromise the other.
GATEWAY_AUTH_ENCRYPTION_KEY=change_me_gateway_auth_key

# --- core-api AND gateway (both import @whoobe-cms/core/server) ---
# Pepper for hashing per-website Gateway API keys (docs/plans/api-gateway/
# gateway-auth-authz.md) - core-api hashes a new key at generation time,
# gateway re-hashes a presented key to verify it; both need the same pepper.
SITE_API_KEY_PEPPER=change_me_site_api_key_pepper

# --- Object storage (S3 API): asset-processor and core-api. Owned by the backend - never shipped to the browser. ---
# Local / LAN (default): Garage runs in the stack (COMPOSE_PROFILES=local-s3) and creates its own bucket and key on
# first start. Garage's key format is mandatory: S3_ACCESS_KEY_ID = "GK" + 24 hex, S3_SECRET_ACCESS_KEY = 64 hex:
#   S3_ACCESS_KEY_ID=GK$(openssl rand -hex 12)   S3_SECRET_ACCESS_KEY=$(openssl rand -hex 32)
# (scripts/provision-workspace.sh does this for workspaces.) Do not reuse these values elsewhere.
# Production: AWS S3, another cloud or an existing enterprise S3 is a configuration change only - remove `local-s3`
# from COMPOSE_PROFILES, set S3_CONTAINER_ENDPOINT (what the containers call; S3_ENDPOINT is for processes on the
# host), S3_REGION, S3_BUCKET, the credentials and S3_FORCE_PATH_STYLE (false for AWS). Do NOT self-host a single-node object store in
# production (docs/release/operations/storage-backends.md). Details: docs/release/operations/storage-backends.md.
COMPOSE_PROFILES=local-s3
# S3_CONTAINER_ENDPOINT=https://s3.eu-west-1.amazonaws.com
S3_ENDPOINT=http://${S3_ENDPOINT_HOSTNAME}:9000
S3_BUCKET=whoobe-cms
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change_me_GK_plus_24_hex
S3_SECRET_ACCESS_KEY=change_me_64_hex
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://${WHOOBE_HOSTNAME}:3002/dam-asset

# --- admin-dashboard (Vite) ---
VITE_ASSET_PROCESSOR_URL=http://${WHOOBE_HOSTNAME}:3002
VITE_CORE_API_URL=http://${WHOOBE_HOSTNAME}:3003
VITE_GATEWAY_URL=http://${WHOOBE_HOSTNAME}:3001

# --- gateway ---
GATEWAY_PORT=3001
GATEWAY_CORE_API_URL=http://${WHOOBE_HOSTNAME}:3003
GATEWAY_ASSET_PROCESSOR_URL=http://${WHOOBE_HOSTNAME}:3002
# Extra folder of vendor presets for the "Add Endpoint" picker (*.json, format in apps/gateway/presets/README.md).
# Read on every request, no restart needed; a preset here replaces a built-in one with the same id. Mount it as a
# volume in production to add or adapt presets without rebuilding the image.
# GATEWAY_PRESETS_PATH=/etc/whoobe/gateway-presets
GATEWAY_DEFAULT_RATE_LIMIT_RPS=10
GATEWAY_RATE_LIMIT_BACKEND=memory

# --- logging ---
# Controls log verbosity for all server apps (pino). Values: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
LOG_DIR=./logs

# DAM service token for logger file upload to private log folder in DAM
ASSET_PROCESSOR_URL=http://${WHOOBE_HOSTNAME}:3002
DAM_SERVICE_TOKEN=whoobe_service_token_change_me

# Publishing from the dashboard (docs/plans/website/publish-from-dashboard.md): shared secret between core-api and the publisher
# service (apps/publisher). Empty = no runner accepted (the runner routes answer 503). Generate: openssl rand -hex 32
PUBLISH_RUNNER_TOKEN=
# where the publisher writes <slug>/releases/<job> and the <slug>/current link
PUBLISH_ROOT=./published

# --- whoobe-one-spike (Vite) ---
# Left unset for local dev (served at /, its own port 3006). In production
# behind nginx it's reverse-proxied under /whoobe-one/ (see
# docs/release/operations/deployment.md), so its built asset URLs must share that prefix -
# set VITE_BASE_URL=/whoobe-one/ there, or the editor iframe 404s on its
# own JS/CSS chunks (they resolve against the parent page's origin
# instead, i.e. admin-dashboard's root, which doesn't have them).
# VITE_BASE_URL=/whoobe-one/
# Admin-dashboard: where the embedded editor lives when it is NOT the default
# (localhost:3006 on localhost, /whoobe-one on the current origin elsewhere), e.g.
# a stack on shifted ports: VITE_WHOOBE_ONE_URL=http://localhost:3106/whoobe-one
# (the spike container strips the /whoobe-one prefix itself, nginx/admin-spa.conf / nginx/editor-spa.conf.template).
# VITE_WHOOBE_ONE_URL=
VITE_FONT_FAMILIES=Alfa+Slab+One|Asap+Condensed|Abel|Alice|Alegreya|Amethysta|Archivo+Black|Barlow+Condensed|Bungee+Inline|Expletus+Sans|Lora|Montserrat|Nunito+Sans|Oi|Open+Sans|PT+Sans|Roboto|Roboto+Condensed|Quattrocento|Raleway|Ultra|Yatra+One|Tenor+Sans|Poppins

# --- HTTP hardening (core-api, asset-processor, gateway) ---
# Credentialed CORS is limited to WHOOBE_HOSTNAME (any port/scheme) plus these; localhost is also
# allowed when NODE_ENV is not production. Public routes (/public/*, /preview/*, asset delivery)
# answer any origin but never with credentials.
# CORS_ALLOWED_HOSTS=admin.example.com,studio.example.com
# CORS_ALLOWED_ORIGINS=https://admin.example.com:8443
# Public URL of the admin dashboard, used in password-reset e-mails (default http://$WHOOBE_HOSTNAME:3000)
# ADMIN_PUBLIC_URL=https://cms.example.com
# Force the session cookie's Secure flag on/off (default: on when the request is HTTPS or X-Forwarded-Proto: https)
# COOKIE_SECURE=true
# Number of reverse-proxy hops in front of the API and the gateway (or 'loopback' / CIDR list) so that req.ip -
# used by the login lockout and the public rate limiters (also the gateway's resolve/submit) - is the client's
# address. Leave unset when directly exposed.
# TRUST_PROXY=1
# /dam-asset serves files through the asset-processor with its own S3 credentials. By default (on) an asset whose record
# is not public (is_public=false) needs a logged-in session and answers 404 to anyone else. Public = uploaded into a
# folder with a public rule: /public/** (sub-folders included) is built in; the DAM settings can add more rules.
# The system `private/` area always needs a session. Set false to restore the old behaviour (anyone with the URL reads).
# DAM_ENFORCE_ASSET_VISIBILITY=false

# --- Outbound requests to operator-supplied URLs (gateway upstreams, OpenAPI import, custom AI endpoints) ---
# Link-local/metadata (169.254.0.0/16), unspecified, multicast and reserved ranges are always refused.
# OUTBOUND_ALLOW_LOOPBACK=false   (default: false in production, true otherwise)
# OUTBOUND_ALLOW_PRIVATE=true     (RFC1918 / ULA / CGNAT; set false for internet-facing or multi-tenant installs)
# OUTBOUND_ALLOW_HOSTS=pimcore.lan,llm.internal   (hostnames exempt from every check, e.g. a LAN API or a local LLM)

# --- Gateway form submissions ---
# Submit bindings created by saving a page carry the form's own field names; only those are forwarded upstream.
# Bindings from pages saved before that existed forward every field (and log a warning). Set true to refuse them
# (HTTP 409) once the pages have been saved again and the sites republished.
# GATEWAY_REQUIRE_FIELD_ALLOWLIST=true

# --- Throttling and publishing (core-api) ---
# Per client address, per minute; 0 switches a limit off. Behind a proxy set TRUST_PROXY. A site rendered on a
# server (SSR/ISR) calls the API from ONE address, so keep these generous for that host.
# PUBLIC_RATE_LIMIT_PER_MINUTE=3000
# PUBLIC_SEARCH_RATE_LIMIT_PER_MINUTE=120
# PUBLIC_QUERY_RATE_LIMIT_PER_MINUTE=600
# AI generation, per user per minute:
# AI_RATE_LIMIT_PER_MINUTE=20
# Changing "published" on pages/objects needs the objects:publish permission. Set false to restore the old
# behaviour (objects:write was enough).
# ENFORCE_PUBLISH_PERMISSION=false
# Largest image (in pixels) the DAM will decode; 0 = sharp's own default (268 MP).
# ASSET_MAX_INPUT_PIXELS=100000000

# --- MFA secrets at rest ---
# Key for encrypting users' TOTP secrets in the database (AES-256-GCM, stored as enc:v1:...). Generate with
# `openssl rand -hex 32`. Existing clear-text secrets are encrypted at the next start. Keep it with your other
# secrets: if it is lost, encrypted secrets cannot be read and users have to enrol MFA again. Not set = secrets
# stay in clear text (a warning is logged).
# TOTP_ENCRYPTION_KEY=

# --- Outgoing-mail credentials at rest ---
# Key for encrypting the SMTP password and the API keys of HTTP mail providers (OneSignal ...) that are saved in
# Settings > Mail (AES-256-GCM). Generate with `openssl rand -hex 32` and keep it with your other secrets: if it is
# lost the saved passwords/keys cannot be read and have to be entered again. Not set = no password or API key can be
# saved (the screen says so); a password saved before this existed stays readable and is encrypted at the next start
# once the key is set.
MAIL_SETTINGS_ENCRYPTION_KEY=change_me_mail_settings_key

# Signs the one-file upload tickets of form Upload fields (any random string of 32+ characters: openssl rand -hex 32).
# Without it file uploads in forms answer 503. UPLOAD_PUBLIC_BASE_URL is optional: the address visitors' browsers send the file
# bytes to when it is not the same host as the page's API (in development: http://localhost:3002).
UPLOAD_TOKEN_SECRET=change_me_upload_token_secret

# --- Third-party credentials at rest ---
# Key for encrypting the AI provider keys (text, image, translation), the Figma token and the push provider (OneSignal) key that
# are saved in the dashboard (AES-256-GCM, stored as enc:v1:...; finding F-055). Generate with `openssl rand -hex 32`. Existing clear-text
# values are encrypted at the next start once it is set. Not set = they stay in clear text (a warning is logged). Keep it with your
# other secrets: if it is lost the credentials have to be entered again.
# INTEGRATION_SECRETS_ENCRYPTION_KEY=
#UPLOAD_PUBLIC_BASE_URL=
# Per address and minute: approvals of a file (default 20) and file bodies received (default 30).
#UPLOAD_INTENT_RATE_LIMIT_PER_MINUTE=20
#UPLOAD_PUT_RATE_LIMIT_PER_MINUTE=30
# Extra folder of mail provider definitions (*.json, format of packages/core/mail-providers/onesignal.json). Read again
# when a file changes, no restart; a provider here replaces a built-in one with the same id.
# MAIL_PROVIDERS_PATH=/etc/whoobe/mail-providers

# First admin: e-mail and password. Leave the password empty/unset to have a random one generated and printed once
# in the core-api log on first start.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=

# --- Published ports (docker-compose.yml) ---
# Postgres and the S3 store listen on 127.0.0.1 only (WS_S3_API_PORT, default 9000). Set 0.0.0.0 to reach them from another machine (then use strong
# secrets and a firewall).
# WS_DATA_BIND_ADDRESS=127.0.0.1
# The application ports (admin 3000, gateway 3001, asset-processor 3002, core-api 3003, editor 3006) listen on all
# interfaces by default so that LAN development works. Behind a reverse proxy on the same host use 127.0.0.1
# (provision-workspace.sh sets it for every workspace).
# WS_APP_BIND_ADDRESS=127.0.0.1

# --- Upload limits and public sandbox mode (docs/release/operations/sandbox.md) ---
# Per-file upload cap in bytes (asset-processor) and maximum number of assets; unset = 50 MB and no count limit.
# ASSET_MAX_FILE_BYTES=5242880
# ASSET_MAX_COUNT=50
# SANDBOX_MODE=1 disables AI, mail, Figma/migration imports, CDN mirror, PWA generation and all outbound HTTP, and shows
# the reset banner. Not set by hand: provision-workspace.sh --profile sandbox writes it with the other limits (see
# deploy/profiles/sandbox.env and docs/release/operations/sandbox.md).
# SANDBOX_MODE=
# SANDBOX_RESET_AT=
# Host names (exact, comma-separated) that outbound HTTP may still reach in the sandbox; the profile sets dummyjson.com.
# SANDBOX_ALLOW_HOSTS=dummyjson.com
