# Whoobe CMS - single source of truth for all configuration.
#
# Every app reads this one file: docker-compose.yml interpolates the
# POSTGRES_* vars; the Node services (core-api, asset-processor,
# migration-tool) load it through @whoobe-cms/core's loadRootEnv(); the
# Vite apps (admin-dashboard, whoobe-one-spike) load it via envDir in
# their vite.config.ts.
#
# ${VAR} references are expanded - Vite does this natively (dotenv-expand),
# loadRootEnv() implements the same expansion for the Node services.
# Shell-exported variables always win over the values in this file, which
# is how ./dev-cms.sh --hostname <name> overrides the hostname per run.

# The hostname all derived URLs below are built from. Change it here for
# the whole stack at once (e.g. WHOOBE_HOSTNAME=develop.local for LAN
# access), or per run via: ./dev-cms.sh --hostname develop.local
WHOOBE_HOSTNAME=localhost
DB_HOSTNAME=localhost
S3_ENDPOINT_HOSTNAME=localhost

# --- Postgres container (docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=whoobe_db

# --- Shared Postgres connection (core-api, asset-processor, migration-tool) ---
DB_HOST=${DB_HOSTNAME}
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=whoobe_db

# --- core-api only ---
# Encryption key for stored Pimcore migration sources (aes-256, 32 bytes).
MIGRATION_SOURCE_ENCRYPTION_KEY=my_secret_key_example

# --- gateway only ---
# Encryption key for stored API Gateway endpoint credentials (aes-256, 32
# bytes) - separate from MIGRATION_SOURCE_ENCRYPTION_KEY above so a leak of
# one secret class doesn't compromise the other.
GATEWAY_AUTH_ENCRYPTION_KEY=change_me_gateway_auth_key

# --- asset-processor only: S3/MinIO connection ---
# Owned exclusively by the backend - never shipped to the browser.
S3_ENDPOINT=http://${S3_ENDPOINT_HOSTNAME}:9000
S3_BUCKET=whoobe-cms
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://${WHOOBE_HOSTNAME}:3002/dam-asset

# --- admin-dashboard (Vite) ---
VITE_ASSET_PROCESSOR_URL=http://${WHOOBE_HOSTNAME}:3002
VITE_CORE_API_URL=http://${WHOOBE_HOSTNAME}:3003
VITE_GATEWAY_URL=http://${WHOOBE_HOSTNAME}:3001

# --- gateway ---
GATEWAY_PORT=3001
GATEWAY_CORE_API_URL=http://${WHOOBE_HOSTNAME}:3003
GATEWAY_ASSET_PROCESSOR_URL=http://${WHOOBE_HOSTNAME}:3002
GATEWAY_DEFAULT_RATE_LIMIT_RPS=10
GATEWAY_RATE_LIMIT_BACKEND=memory

# --- logging ---
# Controls log verbosity for all server apps (pino). Values: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
LOG_DIR=./logs

# DAM service token for logger file upload to private log folder in DAM
ASSET_PROCESSOR_URL=http://${WHOOBE_HOSTNAME}:3002
DAM_SERVICE_TOKEN=whoobe_service_token_change_me

# --- whoobe-one-spike (Vite) ---
# Left unset for local dev (served at /, its own port 3006). In production
# behind nginx it's reverse-proxied under /whoobe-one/ (see
# docs/deployment.md), so its built asset URLs must share that prefix -
# set VITE_BASE_URL=/whoobe-one/ there, or the editor iframe 404s on its
# own JS/CSS chunks (they resolve against the parent page's origin
# instead, i.e. admin-dashboard's root, which doesn't have them).
# VITE_BASE_URL=/whoobe-one/
VITE_FONT_FAMILIES=Alfa+Slab+One|Asap+Condensed|Abel|Alice|Alegreya|Amethysta|Archivo+Black|Barlow+Condensed|Bungee+Inline|Expletus+Sans|Lora|Montserrat|Nunito+Sans|Oi|Open+Sans|PT+Sans|Roboto|Roboto+Condensed|Quattrocento|Raleway|Ultra|Yatra+One|Tenor+Sans|Poppins
