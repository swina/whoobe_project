# /etc/whoobe-sandbox.env, read by the reset service (sudo install -m 600 ... : it may hold the demo password).
# Every line is optional except SANDBOX_HOST; names are exact (a misspelled one is silently ignored).
SANDBOX_HOST=sandbox.example.com
# workspace index: the ports are derived from it (3000+10*N, 9000+10*N, ...); pick one whose ports are free
SANDBOX_INDEX=1
# http on a LAN without TLS, https (default) on a public host with enable-tls.sh
SANDBOX_SCHEME=https
SANDBOX_INTERVAL_HOURS=3
# the demo account is PUBLIC; the defaults are demo@whoobe.example / whoobe-sandbox-demo
#SANDBOX_DEMO_EMAIL=
#SANDBOX_DEMO_PASSWORD=
# overrides of the profile (deploy/profiles/sandbox.env)
#SANDBOX_NO_NEW_PRIVILEGES=false    # only with a snap-installed Docker
#SANDBOX_ALLOW_HOSTS=dummyjson.com
#ASSET_MAX_FILE_BYTES=5242880
#ASSET_MAX_COUNT=50
