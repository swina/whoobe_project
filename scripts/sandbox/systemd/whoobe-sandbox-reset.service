[Unit]
Description=Rebuild the Whoobe public sandbox (all volumes are deleted)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/whoobe_project
EnvironmentFile=/etc/whoobe-sandbox.env
ExecStart=/opt/whoobe_project/scripts/sandbox/reset.sh
# a build normally takes a few minutes; one that stalls (a dependency download that never ends) is killed and tried again
TimeoutStartSec=15min
Restart=on-failure
RestartSec=60
# Host-specific values (user, repository path) go in a drop-in: see override.conf.example
